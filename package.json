{
  "name": "sheet-music-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/prepare-assets.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.ts *.json README.md",
    "docs:screenshots": "node scripts/capture-docs.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide": "^1.52.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
